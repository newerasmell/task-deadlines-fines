# --- Core ---
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Timezone used to format dates/times inside notification text (Telegram,
# Slack, email, etc.). The server itself usually runs in UTC (e.g. on
# Render), so without this, notifications show times hours off from what
# the app displays in the browser.
TZ_NAME="Europe/Sofia"

# How often the deadline/fine scheduler runs (cron expression). Default: every 5 minutes.
SCHEDULER_CRON="*/5 * * * *"
# How many hours before the deadline to send a reminder notification.
REMINDER_HOURS_BEFORE=24
# How many hours before the deadline to send a final, last-chance reminder.
REMINDER_FINAL_HOURS_BEFORE=4
# For tasks whose total deadline span exceeds this many hours, also send a
# repeating "still open" reminder every this many hours until it enters the
# REMINDER_HOURS_BEFORE window.
REMINDER_PERIODIC_HOURS=48
# How many hours an Owner has to approve/reject a submitted task before the
# review itself is considered late (and the Owner starts accruing a fine,
# same engine as task deadlines). Measured in BUSINESS hours, not wall-clock
# — a submission made outside REVIEW_BUSINESS_START_HOUR/END_HOUR (or on a
# weekend/BG holiday) starts its clock at the next working day's opening,
# and the clock itself pauses overnight/weekends rather than ticking through
# them. Regular task deadlines are unaffected — this applies only to the
# review-of-a-submission deadline.
REVIEW_DUE_HOURS=24
REVIEW_BUSINESS_START_HOUR=9
REVIEW_BUSINESS_END_HOUR=18
# While a submission is still waiting on the Owner, repeat a reminder every
# this many hours from the moment it was submitted.
REVIEW_REMINDER_PERIODIC_HOURS=4
# Send one last "about to be fined" reminder this many hours before the
# review is considered late.
REVIEW_REMINDER_FINAL_HOURS_BEFORE=1
# How many days ahead recurring task templates spawn their next occurrence(s)
# (today counts as day 0) — separate knobs per frequency since a monthly task
# warrants more lead time than a weekly one. E.g. RECURRING_LOOKAHEAD_DAYS_WEEKLY=3
# means a WEEKLY occurrence due next Tuesday becomes visible (and eligible
# for the pre-deadline reminder) up to 3 days before that Tuesday, instead
# of only appearing the day it's due.
RECURRING_LOOKAHEAD_DAYS_WEEKLY=3
RECURRING_LOOKAHEAD_DAYS_MONTHLY=10
# Directory (relative to server/) where submitted screenshots/files are stored.
UPLOADS_DIR=uploads

# --- Admin broadcast notifications ---
# Sent on every significant event (task created, submitted, approved/rejected,
# fine issued/waived, overdue) so admins see the whole process, independent
# of any single user's notification channels.
# A Telegram GROUP chat id (add the bot to the group, then read its chat id
# the same way as for a normal user — see README). Group chat ids are negative numbers.
ADMIN_TELEGRAM_CHAT_ID=
# Optional: a separate Slack Incoming Webhook pointed at an #admins channel.
ADMIN_SLACK_WEBHOOK_URL=

# --- Telegram Bot API ---
# Create a bot with @BotFather on Telegram, copy the token here.
TELEGRAM_BOT_TOKEN=

# --- Slack (Incoming Webhook) ---
# Create an Incoming Webhook in your Slack workspace: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Optional: Slack Bot token (xoxb-...) if you want direct-message-per-user delivery instead of a single channel webhook.
SLACK_BOT_TOKEN=

# --- Email / Gmail (SMTP) ---
# For Gmail: enable 2FA on the account, then create an "App Password" and use it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Task Deadlines <no-reply@example.com>"

# --- WhatsApp (Meta WhatsApp Cloud API) ---
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Viber (Viber REST Bot API) ---
# https://developers.viber.com/docs/api/rest-bot-api/
VIBER_BOT_TOKEN=

# --- Google OAuth (Drive API, used by the Google Meet voice-to-tasks import) ---
# https://console.cloud.google.com/ -> create OAuth Client (Web), enable the Drive API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:4000/api/integrations/google/callback"
# After completing the OAuth consent flow once (see README, OAuth Playground
# instructions), paste the refresh token here.
GOOGLE_REFRESH_TOKEN=

# --- Voice-to-tasks ---
# For Whisper transcription. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# For task extraction from the transcript. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Overrides the Claude model id used for extraction (defaults to a current
# Sonnet model in code) — bump this here instead of a code change when a
# newer model should be used.
ANTHROPIC_MODEL=
# Recordings at or under this size are transcribed synchronously within the
# request; larger ones go through the background VoiceProcessingJob path
# instead (the frontend polls GET /voice/jobs/:id). Independent of Whisper's
# own hard 25MB-per-file API limit, which every upload is capped at
# regardless (no audio chunking/compression in this version).
VOICE_SYNC_MAX_BYTES=10485760
# Fallback deadline (working days out, weekends/BG holidays skipped) when
# the extraction doesn't return a usable date for a task.
VOICE_DEFAULT_DEADLINE_WORKING_DAYS=3

# --- Voice-to-tasks: Google Meet auto-import ---
# Requires the Google OAuth vars above (Drive API scope). When Meet's
# recording setting saves to Drive, it drops the video/audio and its own
# auto-generated transcript Doc into a folder named below — the server
# polls that folder, skips anything already imported, and runs each new
# file through the same transcribe->extract->draft pipeline as an upload.
# Must match the Drive folder name exactly.
GOOGLE_MEET_FOLDER_NAME="Meet Recordings"
# How often to poll that folder (cron expression). Default: every 10 minutes.
GOOGLE_MEET_POLL_CRON="*/10 * * * *"
# Max number of new files to process per poll cycle (keeps one big backlog
# from burning through Whisper/Claude quota in a single tick).
GOOGLE_MEET_MAX_PER_POLL=5
