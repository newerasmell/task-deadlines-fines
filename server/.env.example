# --- Core ---
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Timezone used to format dates/times inside notification text (Telegram,
# Slack, email, etc.). The server itself usually runs in UTC (e.g. on
# Render), so without this, notifications show times hours off from what
# the app displays in the browser.
TZ_NAME="Europe/Sofia"

# How often the deadline/fine scheduler runs (cron expression). Default: every 5 minutes.
SCHEDULER_CRON="*/5 * * * *"
# How many hours before the deadline to send a reminder notification.
REMINDER_HOURS_BEFORE=24
# How many hours before the deadline to send a final, last-chance reminder.
REMINDER_FINAL_HOURS_BEFORE=4
# For tasks whose total deadline span exceeds this many hours, also send a
# repeating "still open" reminder every this many hours until it enters the
# REMINDER_HOURS_BEFORE window.
REMINDER_PERIODIC_HOURS=48
# How many hours an Owner has to approve/reject a submitted task before the
# review itself is considered late (and the Owner starts accruing a fine,
# same engine as task deadlines).
REVIEW_DUE_HOURS=24
# How many days ahead recurring task templates spawn their next occurrence(s)
# (today counts as day 0). E.g. 3 means an occurrence due next Tuesday
# becomes visible (and eligible for the pre-deadline reminder) up to 3 days
# before that Tuesday, instead of only appearing the day it's due.
RECURRING_LOOKAHEAD_DAYS=3
# Directory (relative to server/) where submitted screenshots/files are stored.
UPLOADS_DIR=uploads

# --- Admin broadcast notifications ---
# Sent on every significant event (task created, submitted, approved/rejected,
# fine issued/waived, overdue) so admins see the whole process, independent
# of any single user's notification channels.
# A Telegram GROUP chat id (add the bot to the group, then read its chat id
# the same way as for a normal user — see README). Group chat ids are negative numbers.
ADMIN_TELEGRAM_CHAT_ID=
# Optional: a separate Slack Incoming Webhook pointed at an #admins channel.
ADMIN_SLACK_WEBHOOK_URL=

# --- Telegram Bot API ---
# Create a bot with @BotFather on Telegram, copy the token here.
TELEGRAM_BOT_TOKEN=

# --- Slack (Incoming Webhook) ---
# Create an Incoming Webhook in your Slack workspace: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# Optional: Slack Bot token (xoxb-...) if you want direct-message-per-user delivery instead of a single channel webhook.
SLACK_BOT_TOKEN=

# --- Email / Gmail (SMTP) ---
# For Gmail: enable 2FA on the account, then create an "App Password" and use it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Task Deadlines <no-reply@example.com>"

# --- WhatsApp (Meta WhatsApp Cloud API) ---
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Viber (Viber REST Bot API) ---
# https://developers.viber.com/docs/api/rest-bot-api/
VIBER_BOT_TOKEN=

# --- Google Calendar / Gmail API (OAuth2) ---
# https://console.cloud.google.com/ -> create OAuth Client (Web), enable Calendar API + Gmail API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:4000/api/integrations/google/callback"
# After completing the OAuth consent flow once (see README), paste the refresh token here.
GOOGLE_REFRESH_TOKEN=
