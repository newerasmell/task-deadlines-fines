generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so the enum-shaped fields
// below are plain Strings; valid values are validated in the app layer
// (see src/routes/*.ts zod schemas):
//   Role:                ADMIN | EMPLOYEE
//   TaskStatus:          PENDING | IN_PROGRESS | PENDING_REVIEW | DONE | OVERDUE | CANCELLED
//   Priority:            LOW | MEDIUM | HIGH | CRITICAL
//   FineStatus:          ACTIVE | WAIVED | PAID
//   NotificationChannel: TELEGRAM | SLACK | EMAIL | WHATSAPP | VIBER | GOOGLE_CALENDAR
//   NotificationStatus:  SENT | FAILED | SKIPPED
//   ReviewStatus:        PENDING | APPROVED | REJECTED
//   AttachmentKind:      SUBMISSION | REVIEW

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("EMPLOYEE")
  active        Boolean  @default(true)
  // The one (or few) accounts allowed to grant/revoke ADMIN role, the
  // canAssignTasks ("Отговорник"/Lead) permission, and other Leads'
  // assignment scopes. Regular Admins cannot touch these.
  isSuperAdmin  Boolean  @default(false)
  // "Отговорник"/Lead: allowed to create tasks for other employees (within
  // their assignmentScope below), not just for themselves. Everyone —
  // Leads and regular employees alike — can always create a task for
  // themselves; see AssignmentScope and the self-assignment rule in
  // POST /tasks (a self-assigned task's Owner must be an Admin).
  canAssignTasks Boolean @default(false)

  phone         String?
  telegramChatId String?
  slackMemberId  String?
  whatsappPhone  String?
  viberUserId    String?
  googleCalendarId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasksAssigned Task[]   @relation("AssignedTasks")
  tasksCreated  Task[]   @relation("CreatedTasks")
  tasksOwned    Task[]   @relation("OwnedTasks")
  fines         Fine[]   @relation("UserFines")
  finesWaived   Fine[]   @relation("WaivedByUser")
  notificationLogs NotificationLog[]
  submissions   TaskSubmission[] @relation("SubmittedBy")
  reviews       TaskSubmission[] @relation("ReviewedBy")
  templatesAssigned RecurringTaskTemplate[] @relation("TemplateAssignee")
  templatesOwned    RecurringTaskTemplate[] @relation("TemplateOwner")
  templatesCreated  RecurringTaskTemplate[] @relation("TemplateCreatedBy")
  auditLogs     AuditLog[]
  // Employees this user (as a Lead) is allowed to create/assign tasks for.
  assignableEmployees AssignmentScope[] @relation("LeadScope")
  // Leads who are allowed to assign tasks to this user.
  assignableByLeads   AssignmentScope[] @relation("EmployeeScope")
  // The one specific fine rule this account is pinned to, if any.
  fineRuleAssignment  FineRuleAssignment?
}

// Restricts which employees a given Lead (User.canAssignTasks) may create
// tasks for — configured only by a super admin, per "кой на кого може да
// раздава задачи". A Lead with no rows here can still create tasks for
// themselves (always allowed) but not for anyone else yet.
model AssignmentScope {
  id         String   @id @default(cuid())
  leadId     String
  lead       User     @relation("LeadScope", fields: [leadId], references: [id])
  employeeId String
  employee   User     @relation("EmployeeScope", fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([leadId, employeeId])
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String?
  assigneeId    String
  assignee      User       @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdById   String
  createdBy     User       @relation("CreatedTasks", fields: [createdById], references: [id])
  ownerId       String?
  owner         User?      @relation("OwnedTasks", fields: [ownerId], references: [id])

  templateId    String?
  template      RecurringTaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  deadline      DateTime
  priority      String     @default("MEDIUM")
  status        String     @default("PENDING")

  reminder24hSentAt DateTime?
  reminder4hSentAt  DateTime?
  lastPeriodicReminderAt DateTime?
  lastEscalationAt DateTime?
  completedAt      DateTime?
  deletedAt        DateTime?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  fines         Fine[]
  notificationLogs NotificationLog[]
  submissions   TaskSubmission[]
}

model TaskSubmission {
  id            String     @id @default(cuid())
  taskId        String
  task          Task       @relation(fields: [taskId], references: [id])
  submittedById String
  submittedBy   User       @relation("SubmittedBy", fields: [submittedById], references: [id])
  note          String?

  reviewStatus  String     @default("PENDING")
  reviewDueAt   DateTime?
  reviewedById  String?
  reviewedBy    User?      @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewNote    String?
  reviewedAt    DateTime?
  reviewLastEscalationAt DateTime?
  // Reminder tracking, mirroring Task's reminder24hSentAt/reminder4hSentAt/
  // lastPeriodicReminderAt but for the Owner's review window instead of the
  // assignee's deadline.
  reviewFinalReminderSentAt   DateTime?
  lastPeriodicReviewReminderAt DateTime?

  createdAt     DateTime   @default(now())

  attachments   Attachment[]
}

model Attachment {
  id            String     @id @default(cuid())
  submissionId  String
  submission    TaskSubmission @relation(fields: [submissionId], references: [id])
  // "SUBMISSION" (uploaded by the assignee with their submission) or
  // "REVIEW" (uploaded by the Owner/admin alongside their approve/reject decision).
  kind          String     @default("SUBMISSION")
  filename      String
  originalName  String
  mimeType      String
  size          Int
  createdAt     DateTime   @default(now())
}

model RecurringTaskTemplate {
  id            String     @id @default(cuid())
  title         String
  description   String?
  assigneeId    String
  assignee      User       @relation("TemplateAssignee", fields: [assigneeId], references: [id])
  ownerId       String?
  owner         User?      @relation("TemplateOwner", fields: [ownerId], references: [id])
  createdById   String
  createdBy     User       @relation("TemplateCreatedBy", fields: [createdById], references: [id])

  priority      String     @default("MEDIUM")
  // "WEEKLY" (uses daysOfWeek) or "MONTHLY" (uses dayOfMonth)
  frequency     String     @default("WEEKLY")
  // Comma-separated 3-letter weekday codes, e.g. "TUE,WED" — WEEKLY only
  daysOfWeek    String
  // Day of month 1-31 — MONTHLY only. A value past the end of a shorter
  // month (e.g. 31 in April) spawns on that month's last day instead.
  dayOfMonth    Int?
  // "HH:MM" 24h, server-local time
  timeOfDay     String
  active        Boolean    @default(true)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  occurrences   Task[]
}

// A fine rule no longer keys off the task's priority — the Ultimate Admin
// assigns each rule directly to specific accounts (see FineRuleAssignment).
// A rule with no assigned accounts is the fallback used for anyone without
// a rule of their own.
model FineRule {
  id                String   @id @default(cuid())
  name              String
  baseAmount        Float
  perDayAmount      Float
  graceHours        Float    @default(0)
  maxAmount         Float?
  currency          String   @default("EUR")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignedUsers     FineRuleAssignment[]
}

// Ties one account to (at most) one specific fine rule — enforced by the
// unique userId below, so assigning a user to a new rule always detaches
// them from whichever one they had before.
model FineRuleAssignment {
  id        String   @id @default(cuid())
  ruleId    String
  rule      FineRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Fine {
  id            String     @id @default(cuid())
  taskId        String?
  task          Task?      @relation(fields: [taskId], references: [id])
  userId        String
  user          User       @relation("UserFines", fields: [userId], references: [id])

  amount        Float
  currency      String     @default("EUR")
  reason        String
  daysLate      Int        @default(0)
  status        String     @default("ACTIVE")

  waivedById    String?
  waivedBy      User?      @relation("WaivedByUser", fields: [waivedById], references: [id])
  waivedReason  String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model NotificationChannelConfig {
  id        String   @id @default(cuid())
  channel   String   @unique
  enabled   Boolean  @default(false)
  config    String   @default("{}")
  updatedAt DateTime @updatedAt
}

// Records every admin-driven mutation (task create/edit/delete, fine
// issue/waive) so nothing can be silently deleted or changed without a
// trace — see AdminAction below for the allowed `action` values.
//   AdminAction: TASK_CREATED | TASK_UPDATED | TASK_DELETED | FINE_CREATED | FINE_WAIVED
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  summary    String
  // JSON snapshot of the entity (full state for deletes, changed fields for updates).
  details    String?
  createdAt  DateTime @default(now())
}

model NotificationLog {
  id        String   @id @default(cuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String
  status    String
  message   String
  error     String?
  createdAt DateTime @default(now())
}
