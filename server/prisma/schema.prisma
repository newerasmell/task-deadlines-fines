generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so the enum-shaped fields
// below are plain Strings; valid values are validated in the app layer
// (see src/routes/*.ts zod schemas):
//   Role:                ADMIN | EMPLOYEE
//   TaskStatus:          PENDING | IN_PROGRESS | PENDING_REVIEW | DONE | OVERDUE | CANCELLED
//   Priority:            LOW | MEDIUM | HIGH | CRITICAL
//   FineStatus:          ACTIVE | WAIVED | PAID
//   NotificationChannel: TELEGRAM | SLACK | EMAIL | WHATSAPP | VIBER | GOOGLE_CALENDAR
//   NotificationStatus:  SENT | FAILED | SKIPPED
//   ReviewStatus:        PENDING | APPROVED | REJECTED
//   AttachmentKind:      SUBMISSION | REVIEW

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("EMPLOYEE")
  active        Boolean  @default(true)
  // The one (or few) accounts allowed to grant/revoke ADMIN role, the
  // canAssignTasks ("Отговорник"/Lead) permission, and other Leads'
  // assignment scopes. Regular Admins cannot touch these.
  isSuperAdmin  Boolean  @default(false)
  // "Отговорник"/Lead: allowed to create tasks for other employees (within
  // their assignmentScope below), not just for themselves. Everyone —
  // Leads and regular employees alike — can always create a task for
  // themselves; see AssignmentScope and the self-assignment rule in
  // POST /tasks (a self-assigned task's Owner must be an Admin).
  canAssignTasks Boolean @default(false)
  // Grants access to the separate "Абонаменти" page (domains, phone
  // numbers, recurring subscriptions — things with a payment due date, no
  // fines involved). Off by default; toggled per-account only by a super
  // admin, same as canAssignTasks above.
  canAccessSubscriptions Boolean @default(false)

  phone         String?
  telegramChatId String?
  slackMemberId  String?
  whatsappPhone  String?
  viberUserId    String?
  googleCalendarId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasksAssigned Task[]   @relation("AssignedTasks")
  tasksCreated  Task[]   @relation("CreatedTasks")
  tasksOwned    Task[]   @relation("OwnedTasks")
  fines         Fine[]   @relation("UserFines")
  finesWaived   Fine[]   @relation("WaivedByUser")
  notificationLogs NotificationLog[]
  submissions   TaskSubmission[] @relation("SubmittedBy")
  reviews       TaskSubmission[] @relation("ReviewedBy")
  templatesAssigned RecurringTaskTemplate[] @relation("TemplateAssignee")
  templatesOwned    RecurringTaskTemplate[] @relation("TemplateOwner")
  templatesCreated  RecurringTaskTemplate[] @relation("TemplateCreatedBy")
  projectsCreated   Project[] @relation("CreatedProjects")
  auditLogs     AuditLog[]
  // Employees this user (as a Lead) is allowed to create/assign tasks for.
  assignableEmployees AssignmentScope[] @relation("LeadScope")
  // Leads who are allowed to assign tasks to this user.
  assignableByLeads   AssignmentScope[] @relation("EmployeeScope")
  // The one specific fine rule this account is pinned to, if any.
  fineRuleAssignment  FineRuleAssignment?
  leaves              Leave[]             @relation("UserLeaves")
  leavesCreated       Leave[]             @relation("LeaveCreatedBy")
  rescheduleRequestsMade     RescheduleRequest[] @relation("RescheduleRequestedBy")
  rescheduleRequestsDecided  RescheduleRequest[] @relation("RescheduleDecidedBy")
  subscriptionsOwned    Subscription[] @relation("SubscriptionOwner")
  subscriptionsCreated  Subscription[] @relation("SubscriptionCreatedBy")
}

// A tracked recurring cost with its own due date — a domain, phone number,
// virtual number, or any other subscription that needs to be paid/renewed
// by a certain time. Entirely separate from Task/Fine: nobody gets fined
// for one of these running out, it's a reminder tool for a small set of
// accounts (see User.canAccessSubscriptions). Reminder tiers are handled by
// subscriptionScanner.ts: once each at 30/15 days out, daily from 7 days
// out (including after the due date, so it never goes silent), and every 2
// hours specifically on the due date's calendar day.
model Subscription {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  dueDate     DateTime
  amount      Float?
  currency    String?  @default("EUR")
  status      String   @default("ACTIVE")

  ownerId     String?
  owner       User?    @relation("SubscriptionOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   User     @relation("SubscriptionCreatedBy", fields: [createdById], references: [id])

  reminder30dSentAt      DateTime?
  reminder15dSentAt      DateTime?
  lastDailyReminderAt    DateTime?
  lastPeriodicReminderAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Restricts which employees a given Lead (User.canAssignTasks) may create
// tasks for — configured only by a super admin, per "кой на кого може да
// раздава задачи". A Lead with no rows here can still create tasks for
// themselves (always allowed) but not for anyone else yet.
model AssignmentScope {
  id         String   @id @default(cuid())
  leadId     String
  lead       User     @relation("LeadScope", fields: [leadId], references: [id])
  employeeId String
  employee   User     @relation("EmployeeScope", fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([leadId, employeeId])
}

// A "сложна задача" — a linear chain of up to 4 Task steps, each one
// assigned (and reviewed) independently, where a step past the first only
// gets a real deadline once its predecessor is approved (see Task.previousStep
// and the chain-activation block in the submission-approve route).
model Project {
  id          String   @id @default(cuid())
  title       String
  createdById String
  createdBy   User     @relation("CreatedProjects", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  steps       Task[]
}

// A personal vacation/leave block — a day range an employee (or an Admin on
// their behalf) has marked as unavailable. Two things flow from a Leave,
// both automatic: the fine engine excludes days inside it from that
// person's lateness count (see leaveHoursOverlap in deadlineScanner.ts,
// applied to both the assignee's deadline and the owner's review clock),
// and creating it scans that person's open tasks for ones due inside the
// range and files a RescheduleRequest for each (see POST /leaves) — the
// deadline itself never moves without the task's Owner (or an Admin)
// approving that request.
model Leave {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserLeaves", fields: [userId], references: [id])
  startDate   DateTime
  endDate     DateTime
  note        String?
  createdById String
  createdBy   User     @relation("LeaveCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  rescheduleRequests RescheduleRequest[]
}

// Filed automatically when a Leave overlaps an open task's deadline.
// status: PENDING | APPROVED | REJECTED — decided by the same people who
// can review a submission (the task's Owner, or an Admin if it has none).
// Approving copies proposedDeadline onto the Task exactly like an Admin's
// manual deadline edit (same reminder/escalation reset).
model RescheduleRequest {
  id               String    @id @default(cuid())
  taskId           String
  task             Task      @relation(fields: [taskId], references: [id])
  leaveId          String?
  leave            Leave?    @relation(fields: [leaveId], references: [id], onDelete: SetNull)
  requestedById    String
  requestedBy      User      @relation("RescheduleRequestedBy", fields: [requestedById], references: [id])
  currentDeadline  DateTime
  proposedDeadline DateTime
  note             String?
  status           String    @default("PENDING")
  decidedById      String?
  decidedBy        User?     @relation("RescheduleDecidedBy", fields: [decidedById], references: [id])
  decisionNote     String?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String?
  assigneeId    String
  assignee      User       @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdById   String
  createdBy     User       @relation("CreatedTasks", fields: [createdById], references: [id])
  ownerId       String?
  owner         User?      @relation("OwnedTasks", fields: [ownerId], references: [id])

  templateId    String?
  template      RecurringTaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Multi-step chain ("сложна задача"): this task is one link, belonging to
  // Project and pointing at the step immediately before it. A step past the
  // first starts out with status "BLOCKED" and a placeholder far-future
  // deadline (never acted on by the scanner — BLOCKED isn't in any status
  // list it scans) until its previousStep is approved, at which point the
  // approve route computes the real deadline (approval time + delayDays)
  // and flips it to PENDING — see approveSubmission's chain-activation block.
  projectId     String?
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  chainOrder    Int?
  delayDaysAfterPrevious Int?
  previousStepId String?   @unique
  previousStep  Task?      @relation("ChainLink", fields: [previousStepId], references: [id])
  nextStep      Task?      @relation("ChainLink")

  deadline      DateTime
  priority      String     @default("MEDIUM")
  status        String     @default("PENDING")

  reminder24hSentAt DateTime?
  reminder4hSentAt  DateTime?
  lastPeriodicReminderAt DateTime?
  lastEscalationAt DateTime?
  // The daysLate value the most recent fine on THIS deadline cycle was for.
  // Fine history (including waived fines) is excluded from this check on
  // purpose: waiving a fine forgives that day, it must not make the scanner
  // re-fine the exact same day again on its next pass. Editing the deadline
  // starts a fresh cycle and resets this to null (see PATCH /tasks/:id).
  lastFinedDaysLate Int?
  completedAt      DateTime?
  deletedAt        DateTime?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  fines         Fine[]
  notificationLogs NotificationLog[]
  submissions   TaskSubmission[]
  rescheduleRequests RescheduleRequest[]
}

model TaskSubmission {
  id            String     @id @default(cuid())
  taskId        String
  task          Task       @relation(fields: [taskId], references: [id])
  submittedById String
  submittedBy   User       @relation("SubmittedBy", fields: [submittedById], references: [id])
  note          String?

  reviewStatus  String     @default("PENDING")
  reviewDueAt   DateTime?
  reviewedById  String?
  reviewedBy    User?      @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewNote    String?
  reviewedAt    DateTime?
  reviewLastEscalationAt DateTime?
  // Mirrors Task.lastFinedDaysLate — the daysLate value the most recent
  // review fine was for, tracked independently of Fine.status so a waived
  // review fine doesn't get immediately re-created on the next scan.
  reviewLastFinedDaysLate Int?
  // Reminder tracking, mirroring Task's reminder24hSentAt/reminder4hSentAt/
  // lastPeriodicReminderAt but for the Owner's review window instead of the
  // assignee's deadline.
  reviewFinalReminderSentAt   DateTime?
  lastPeriodicReviewReminderAt DateTime?

  createdAt     DateTime   @default(now())

  attachments   Attachment[]
}

model Attachment {
  id            String     @id @default(cuid())
  submissionId  String
  submission    TaskSubmission @relation(fields: [submissionId], references: [id])
  // "SUBMISSION" (uploaded by the assignee with their submission) or
  // "REVIEW" (uploaded by the Owner/admin alongside their approve/reject decision).
  kind          String     @default("SUBMISSION")
  filename      String
  originalName  String
  mimeType      String
  size          Int
  createdAt     DateTime   @default(now())
}

model RecurringTaskTemplate {
  id            String     @id @default(cuid())
  title         String
  description   String?
  assigneeId    String
  assignee      User       @relation("TemplateAssignee", fields: [assigneeId], references: [id])
  ownerId       String?
  owner         User?      @relation("TemplateOwner", fields: [ownerId], references: [id])
  createdById   String
  createdBy     User       @relation("TemplateCreatedBy", fields: [createdById], references: [id])

  priority      String     @default("MEDIUM")
  // "WEEKLY" (uses daysOfWeek) or "MONTHLY" (uses dayOfMonth)
  frequency     String     @default("WEEKLY")
  // Comma-separated 3-letter weekday codes, e.g. "TUE,WED" — WEEKLY only
  daysOfWeek    String
  // Day of month 1-31 — MONTHLY only. A value past the end of a shorter
  // month (e.g. 31 in April) spawns on that month's last day instead.
  dayOfMonth    Int?
  // "HH:MM" 24h, server-local time
  timeOfDay     String
  active        Boolean    @default(true)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  occurrences   Task[]
}

// A fine rule no longer keys off the task's priority — the Ultimate Admin
// assigns each rule directly to specific accounts (see FineRuleAssignment).
// A rule with no assigned accounts is the fallback used for anyone without
// a rule of their own.
model FineRule {
  id                String   @id @default(cuid())
  name              String
  baseAmount        Float
  perDayAmount      Float
  graceHours        Float    @default(0)
  maxAmount         Float?
  currency          String   @default("EUR")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignedUsers     FineRuleAssignment[]
}

// Ties one account to (at most) one specific fine rule — enforced by the
// unique userId below, so assigning a user to a new rule always detaches
// them from whichever one they had before.
model FineRuleAssignment {
  id        String   @id @default(cuid())
  ruleId    String
  rule      FineRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Fine {
  id            String     @id @default(cuid())
  taskId        String?
  task          Task?      @relation(fields: [taskId], references: [id])
  userId        String
  user          User       @relation("UserFines", fields: [userId], references: [id])

  amount        Float
  currency      String     @default("EUR")
  reason        String
  daysLate      Int        @default(0)
  status        String     @default("ACTIVE")

  waivedById    String?
  waivedBy      User?      @relation("WaivedByUser", fields: [waivedById], references: [id])
  waivedReason  String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model NotificationChannelConfig {
  id        String   @id @default(cuid())
  channel   String   @unique
  enabled   Boolean  @default(false)
  config    String   @default("{}")
  updatedAt DateTime @updatedAt
}

// Records every admin-driven mutation (task create/edit/delete, fine
// issue/waive) so nothing can be silently deleted or changed without a
// trace — see AdminAction below for the allowed `action` values.
//   AdminAction: TASK_CREATED | TASK_UPDATED | TASK_DELETED | FINE_CREATED | FINE_WAIVED
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  summary    String
  // JSON snapshot of the entity (full state for deletes, changed fields for updates).
  details    String?
  createdAt  DateTime @default(now())
}

model NotificationLog {
  id        String   @id @default(cuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String
  status    String
  message   String
  error     String?
  createdAt DateTime @default(now())
}
