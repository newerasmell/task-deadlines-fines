generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per person who can log in. Everyone can see/change the store &
// pricing data the same way (no role split there) — this exists so each
// change can be attributed to a real person (see AuditLog) instead of one
// shared dashboard password. passwordHash is bcrypt; never store/return the
// plaintext password.
model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  // A deactivated user can no longer log in (an active session is also cut
  // the next time requireAuth checks), but their past AuditLog rows are
  // kept — "who did this" should still be answerable after someone leaves.
  active          Boolean  @default(true)
  // Account management (see the other User rows, create/edit/deactivate/
  // delete them, grant/revoke this flag) is restricted to ultimate admins
  // — everyone else can only view/edit their OWN name and password (see
  // PATCH /auth/me). The bootstrap account created via /auth/setup is
  // always the first ultimate admin. Multiple ultimate admins are allowed;
  // the last one can't be demoted/deactivated/deleted (by themself or
  // anyone else) so the team is never left with none.
  isUltimateAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditLogs       AuditLog[]
}

// One row per meaningful write — store/source config changes, cost edits,
// price publishes, user management — so "who changed X" has an answer.
// Read-only/automatic actions (a scheduled refresh, viewing a page) are
// deliberately not logged here; this is an audit trail of human decisions,
// not a request log.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

// Purely organizational — lets a lot of stores be browsed/managed a group
// at a time (Settings used to list every store flat in one place, which
// stopped being usable once there were more than a handful). A store
// without a group shows up under a synthetic "Ungrouped" bucket in the UI
// rather than needing one.
model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores    Store[]
}

// One row per configured Shopify store/market. admin_api_token is stored
// AES-256-GCM encrypted (see lib/crypto.ts) — never written or read in
// plaintext outside that helper. Pricing rule fields are flattened onto the
// store (1:1) rather than a separate table, since a store always has
// exactly one active rule.
model Store {
  id                String   @id @default(cuid())
  name              String
  myshopifyDomain   String   @unique
  shopifyClientId     String
  shopifyClientSecret String // encrypted at rest — exchanged for a short-lived Admin API access token via the client_credentials grant, not used directly (see shopifyClient.ts)
  marketCode        String
  currency          String
  groupId           String?
  group             Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  pricingStrategy   String   @default("undercut_min") // undercut_min | match_min | undercut_avg
  undercutPct       Float    @default(1)
  priceEnding       String?  // e.g. ".99" — null means no ending adjustment
  minMarginPct      Float    @default(10)

  // "competitor" (default, the engine above) or "cod_formula" — a COD store
  // prices off its own cost/logistics/ad-spend formula instead of tracking
  // competitor prices; see CodFormulaConfig and codPricingEngine.ts.
  pricingProfile    String   @default("competitor")

  // Opt-in, per store — the "Продажби" tab (6-month units sold/avg realized
  // price/page views/conv-rate, rolled up by Shopify collection) only shows
  // up and only syncs for a store with this on. Off by default: it needs a
  // read_orders Shopify scope most stores haven't granted yet, and GA4 wiring
  // most stores haven't configured — turning it on for everyone would just
  // show empty/broken data for stores that aren't set up for it.
  salesAnalyticsEnabled Boolean @default(false)
  // New-arrival markdown (COD-formula stores only): a product added to
  // markdownCollectionId starts a countdown the moment it's first observed
  // ACTIVE in Shopify (Product.activatedAt). Once markdownAfterDays have
  // passed, if its current price still sits above the formula's recommended
  // price by more than markdownCeilingPct, the Pricing table flags it and
  // overrides its suggestion down to that ceiling — see
  // codPricingEngine.ts's markdown functions. Off by default; needs
  // salesAnalyticsEnabled too, since that's what syncs Category rows to
  // pick markdownCollectionId from in the first place.
  markdownEnabled     Boolean  @default(false)
  markdownCollectionId String?
  markdownCollection  Category? @relation("MarkdownCollection", fields: [markdownCollectionId], references: [id], onDelete: SetNull)
  markdownAfterDays   Int      @default(8)
  markdownCeilingPct  Float    @default(12.5)

  // GA4 property to pull page views from (e.g. "properties/123456789") —
  // null means the page-views/conv-rate columns stay blank even with
  // salesAnalyticsEnabled on; see services/ga4Client.ts.
  ga4PropertyId         String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sources           Source[]
  products          Product[]
  costs             Cost[]
  manualMatches     ManualMatch[]
  publishLogs       PublishLog[]
  codFormulaConfig  CodFormulaConfig?
  categories        Category[] @relation("StoreCategories")
  brands            Brand[]
}

// Up to 3 active competitor sources per store. Refresh health (degraded
// flag / consecutive failure count) lives here so the UI can show a source
// as struggling without digging through logs.
model Source {
  id                  String   @id @default(cuid())
  storeId             String
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  label               String
  type                String   // shopify_json | scrape | manual_import | jeftinije_hr
  baseUrl             String
  searchUrlTemplate   String?  // used for type=scrape, e.g. https://x.com/search?q={EAN}
  active              Boolean  @default(true)
  // Whether the 15-min scheduler tick auto-refreshes this source once its
  // 24h window elapses. Defaults true (existing behavior for shopify_json/
  // scrape); jeftinije_hr is created with this off — a full brand-listing
  // crawl is heavy enough that someone should decide when it runs, not a
  // timer — but any source can opt out the same way.
  autoRefresh         Boolean  @default(true)

  lastRefreshedAt     DateTime?
  // Who clicked "Refresh now" — null when the scheduler triggered it
  // automatically. There's no real multi-user login yet (a single shared
  // dashboard password), so this is "Admin" today; it'll hold a real name
  // once accounts exist, no schema change needed then.
  lastTriggeredBy     String?
  lastMatchedCount    Int?     // prices fetched on the most recent refresh, null = never refreshed
  consecutiveFailures Int      @default(0)
  degraded            Boolean  @default(false)
  lastError           String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  competitorPrices    CompetitorPrice[]
  priceHistory        CompetitorPriceHistory[]
  manualMatches       ManualMatch[]
  scrapeAttempts      ScrapeAttempt[]
  ambiguousMatches    AmbiguousMatch[]
}

// One row per Shopify VARIANT (not per product) — a product's title/vendor/
// handle/image are duplicated across its variant rows, matching how the
// pricing table itself is variant-grain (each row publishes independently).
model Product {
  id                  String   @id @default(cuid())
  storeId             String
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  shopifyProductId    String
  shopifyVariantId    String

  title               String
  vendor              String?
  handle              String?
  sku                 String?
  barcode             String?
  price               Float
  compareAtPrice      Float?
  inventoryQuantity   Int?
  imageUrl            String?
  // Comma-joined Shopify product tags (e.g. "sale,new") — used by the
  // cod_formula profile to flag which products are tagged as discounted.
  tags                String?

  // Manual "always scrape this one every run" flag; the top-N-by-inventory-
  // value rule is computed on the fly at scrape-scheduling time, not stored.
  priority            Boolean  @default(false)

  // Shopify's own product status (ACTIVE | DRAFT | ARCHIVED) and publish
  // timestamp — synced read-only, purely informational.
  shopifyStatus       String?
  shopifyPublishedAt  DateTime?
  // OUR OWN stamp of the first sync that ever observed this variant's
  // status as ACTIVE — set once, never overwritten by a later sync even if
  // the product is archived and reactivated. This (not shopifyPublishedAt,
  // which Shopify can backdate/leave null) is the clock the new-arrival
  // markdown feature counts its 7-10 days from; priceAtActivation is the
  // price snapshotted at that same moment, so a manual price edit made
  // afterwards doesn't change what "the original price" meant when the
  // countdown started. See codPricingEngine.ts's markdown functions.
  activatedAt         DateTime?
  priceAtActivation   Float?

  syncedAt            DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  manualMatches       ManualMatch[]
  scrapeAttempts      ScrapeAttempt[]
  ambiguousMatches    AmbiguousMatch[]
  categories          ProductCategory[]
  sales               ProductSales?
  pageViews           ProductPageViews?

  @@unique([storeId, shopifyVariantId])
  @@index([storeId, barcode])
}

// A Shopify collection the sales-analytics feature groups products by
// ("Category" in the UI — Шапки/Тениски/Чанти etc.). Synced alongside the
// catalog for any store with salesAnalyticsEnabled; a product can sit in
// more than one collection (Shopify allows that), so it can roll up into
// more than one category's totals — same as browsing the storefront.
model Category {
  id                  String   @id @default(cuid())
  storeId             String
  store               Store    @relation("StoreCategories", fields: [storeId], references: [id], onDelete: Cascade)
  // Back-relation for Store.markdownCollection — a Category can be picked
  // as the "new arrivals" collection by at most the one Store it belongs
  // to anyway (markdownCollectionId is store-scoped), so this is always
  // either empty or a single-element list.
  markdownForStores   Store[]  @relation("MarkdownCollection")

  shopifyCollectionId String   // Shopify collection GID
  title               String

  // Manually-set envelope for the "suggested base/compare-at price" shown
  // on the COD-formula Pricing table (replaces the old flat price/(1-
  // discountPct) markup) — both null until an admin sets them on the
  // Продажби tab. A product in this category gets a price somewhere in
  // [baseMinPrice, baseMaxPrice], placed by its brand's coefficient (see
  // Brand) relative to the other brands actually selling in this category.
  baseMinPrice        Float?
  baseMaxPrice        Float?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  products            ProductCategory[]
  categoryCost        CategoryCost?

  @@unique([storeId, shopifyCollectionId])
}

// One coefficient per (store, vendor) — not per category, so "this brand is
// premium" holds across the whole catalog rather than needing to be reset
// for every category it happens to sell in. 1-10, null until an admin sets
// it on the Марки tab; a product whose vendor has no coefficient yet gets no
// suggested base price, same as a category with no min/max set.
model Brand {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  vendor      String   // exact match against Product.vendor
  coefficient Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, vendor])
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
}

// Rolling last-6-months sales aggregate per variant — replaced wholesale on
// each sync (services/ordersSync.ts) rather than storing every order line
// item, since only the 6-month rollup is ever shown. avgSalePrice6m is
// revenue6m / unitsSold6m at read time, not stored, so it's never stale
// relative to the two numbers it's derived from.
model ProductSales {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  unitsSold6m Int
  revenue6m   Float    // sum of realized line-item price * qty, in store currency
  periodStart DateTime
  periodEnd   DateTime
  syncedAt    DateTime @default(now())
}

// Rolling last-6-months GA4 page views per variant's product page — separate
// from ProductSales since it comes from a different source (GA4 Data API,
// see services/ga4Client.ts) on its own sync cadence, and simply doesn't
// exist for a store that hasn't configured ga4PropertyId yet.
model ProductPageViews {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  pageViews6m Int
  periodStart DateTime
  periodEnd   DateTime
  syncedAt    DateTime @default(now())
}

// Manually-entered average acquisition cost for a whole category (e.g.
// "Шапки — 25€") — only meaningful for a store on pricingProfile=cod_formula,
// where codPricingEngine.ts needs a per-product cost to price off of. Used
// as a fallback ONLY for a product with no SKU/EAN row in Cost: importing a
// real cost via costs.csv always wins over this category-wide estimate.
model CategoryCost {
  id         String   @id @default(cuid())
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  cost       Float
  currency   String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A bulk-index source (jeftinije_hr) found more than one plausible
// competitor listing for a product and can't pick confidently on its
// own — parked here for a human to resolve instead of guessing wrong.
// One row per (source, product); re-running the crawl updates the
// candidate list in place as long as it's still pending, and leaves a
// resolved/dismissed row alone unless the candidates actually changed.
model AmbiguousMatch {
  id             String    @id @default(cuid())
  sourceId       String
  source         Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  // JSON array: [{ "title": string, "price": number | null, "url": string }]
  candidatesJson String
  status         String    @default("pending") // pending | resolved | dismissed
  resolvedAt     DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([sourceId, productId])
  @@index([sourceId, status])
}

// Imported via Settings → Import costs (CSV: sku_or_ean,cost).
model Cost {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  skuOrEan   String
  cost       Float

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([storeId, skuOrEan])
}

// One row per store with pricingProfile = "cod_formula" — the formula
// inputs from the COD pricing calculator (n, A/d/S per delivery scenario,
// agency fee, etc.), applied per-product against that product's own cost
// (see Cost above) instead of the competitor-undercut engine. scenariosJson
// / bracketsJson hold small fixed-shape arrays not worth their own tables.
model CodFormulaConfig {
  id            String   @id @default(cuid())
  storeId       String   @unique
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  mode          String   @default("target") // cost | target | breakeven
  cogsPct       Float    @default(40)  // used only in mode=cost
  fRate         Float    @default(5)   // agency fee rate assumed inside the price formula, %
  mRate         Float    @default(10)  // target net profit, % of collected revenue (mode=target)
  nItems        Float    @default(1.3) // items per order
  rMult         Float    @default(2)   // shipping multiple on a failed/returned parcel
  lLoss         Float    @default(0)   // % of cost lost on returned stock
  fCost         Float    @default(5000) // other monthly costs
  roundStep     Float    @default(1)
  discountPct   Float    @default(50) // discount used to derive the compare-at (slashed) price
  discountTag   String   @default("sale") // Shopify tag that marks a product as "discounted" in the UI
  pricingScenario String @default("avg") // pess | avg | opt — which scenario's A/d/S feeds the price formula
  pricingN      Float    @default(1000) // N used for F/N in the price formula (not the live order count)

  // JSON: [{ key: "pess"|"avg"|"opt", label, A, d, S }] — d as a 0-100 %.
  scenariosJson String   @default("[{\"key\":\"pess\",\"label\":\"Песимистичен\",\"A\":25,\"d\":60,\"S\":7},{\"key\":\"avg\",\"label\":\"Среден\",\"A\":20,\"d\":62.5,\"S\":6},{\"key\":\"opt\",\"label\":\"Оптимистичен\",\"A\":15,\"d\":65,\"S\":5}]")
  // JSON: [{ upper: number|null, rate: number }] (rate as a 0-100 %, upper=null means unbounded).
  bracketsJson  String   @default("[{\"upper\":25000,\"rate\":4},{\"upper\":50000,\"rate\":5},{\"upper\":75000,\"rate\":6},{\"upper\":null,\"rate\":7}]")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Latest fetched price per (source, matchKey) — upserted every refresh so
// there's always exactly one current row per competitor listing. matchKey
// is the EAN when known, else a normalized brand+name+ml string, else the
// competitor's own SKU — always computable, always the upsert identity.
// productId is filled in once the matching engine (or a manual binding)
// resolves it; null means it currently shows up in the Unmatched tab.
model CompetitorPrice {
  id                String   @id @default(cuid())
  sourceId          String
  source            Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  productId         String?  // resolved match, if any (not enforced as FK — Product rows get replaced on re-sync)

  matchKey          String
  competitorTitle   String?
  competitorSku     String?
  competitorBarcode String?
  price             Float
  currency          String
  url               String?
  isManual          Boolean  @default(false) // entered by hand on the Pricing Table for a product no automated source found, vs. written by a scraper/CSV import

  fetchedAt         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([sourceId, matchKey])
  @@index([sourceId, productId])
}

// Rolling trend log — pruned to the last 30 rows per (sourceId, matchKey)
// after each insert (see services/competitorHistory.ts).
model CompetitorPriceHistory {
  id        String   @id @default(cuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  matchKey  String
  price     Float
  fetchedAt DateTime @default(now())

  @@index([sourceId, matchKey, fetchedAt])
}

// One row per (source, product) for scrape-type sources — always the LATEST
// attempt, upserted every time a refresh includes that product (not every
// product every run, per the priority/rotation schedule). Lets Settings show
// "did source X actually find a price for product Y last time we checked"
// per product, not just an aggregate count — CompetitorPrice alone only
// shows successes, so a product that's been searched-but-never-found would
// otherwise look identical to one that's never been searched at all.
model ScrapeAttempt {
  id          String   @id @default(cuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  found       Boolean
  price       Float?
  error       String?
  url         String

  attemptedAt DateTime @default(now())

  @@unique([sourceId, productId])
  @@index([sourceId, attemptedAt])
}

// A manually-bound competitor listing for one of our products on one
// source — always takes priority over the automatic EAN/string matcher.
model ManualMatch {
  id                   String   @id @default(cuid())
  storeId              String
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceId             String
  source               Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  productId            String
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  competitorUrlOrEan   String   // whatever the operator pasted
  resolvedMatchKey     String   // EAN if extractable/confirmed, else a synthetic key tied to this binding

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([sourceId, productId])
}

model PublishLog {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  variantId      String   // Shopify variant GID
  productTitle   String?

  oldPrice       Float
  newPrice       Float
  oldCompareAt   Float?
  newCompareAt   Float?

  status         String   // SUCCESS | ERROR
  errorMessage   String?
  source         String   // single | bulk

  createdAt      DateTime @default(now())

  @@index([storeId, createdAt])
}
